{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/brokerage",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?sosville\\.co"
        }
      ],
      "destination": "https://brokerageautomation.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.brokerageautomation.com"
        }
      ],
      "destination": "https://brokerageautomation.com/:path*",
      "permanent": false
    },
    {
      "source": "/brokerage",
      "has": [
        {
          "type": "host",
          "value": "brokerageautomation.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path((?!decks/|screenshots/|brokerage$).+)",
      "has": [
        {
          "type": "host",
          "value": "brokerageautomation.com"
        }
      ],
      "destination": "https://sosville.co/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "brokerageautomation.com"
        }
      ],
      "destination": "/brokerage"
    },
    {
      "source": "/",
      "destination": "/home"
    }
  ]
}
